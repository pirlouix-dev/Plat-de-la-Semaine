# ── Firebase ──────────────────────────────────────────────────────
# Firebase/Firestore project ID.
FIREBASE_PROJECT_ID=

# Base64-encoded service account JSON (used for hosted deployments).
# When unset, Google Application Default Credentials are used instead.
GOOGLE_CREDENTIALS_JSON=

# Firebase Web API key, used for Auth REST calls.
FIREBASE_API_KEY=

# ── Feedback ──────────────────────────────────────────────────────
# Discord webhook URL that receives feedback. When unset, feedback is disabled.
DISCORD_WEBHOOK_URL=

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins.
# Origins must be absolute URLs with no trailing slash.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Hosting ───────────────────────────────────────────────────────
# Development | Production
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5126
